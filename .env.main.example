# =============================================================================
# MAIN branch — separate Supabase project (Plan B)
# =============================================================================
# 1. Create a NEW project at https://supabase.com/dashboard (e.g. "fig-to-cur-main")
# 2. Copy this file to .env.main and paste Project URL + anon key
# 3. Run: npm run env:main
# 4. In Supabase SQL Editor, run base schema only (no iteration-only migrations):
#
# SQL order (fresh project, main branch):
#   trips.sql → trip_members.sql → trip_invites.sql → trip_hotels.sql
#   → trip_flights.sql → member_preferences.sql → trip_itineraries.sql
#
# Do NOT run 007/008/009 here unless you have merged iteration into main.
# =============================================================================

VITE_APP_ENV=main

VITE_GOOGLE_PLACES_API_KEY=

VITE_SUPABASE_URL=https://YOUR_MAIN_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_MAIN_ANON_KEY

GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
FSQ_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173

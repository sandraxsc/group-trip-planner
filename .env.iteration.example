# =============================================================================
# ITERATION branch — separate Supabase project (Plan B)
# =============================================================================
# 1. Create a NEW project at https://supabase.com/dashboard (e.g. "fig-to-cur-iteration")
# 2. Copy this file to .env.iteration and paste Project URL + anon key
# 3. Run: npm run env:iteration
# 4. In Supabase SQL Editor, run scripts in supabase/sql/ (see list below)
#
# SQL order (fresh project, iteration branch):
#   trips.sql → trip_members.sql → trip_invites.sql → trip_hotels.sql
#   → trip_flights.sql → member_preferences.sql → trip_itineraries.sql
#   → 008_trip_outdated_and_regen.sql (skip if trips.sql already has isOutdated)
#   → 009_group_logistics.sql
# Skip 007_versioned_itineraries.sql on a brand-new DB (trip_itineraries.sql is enough).
# =============================================================================

VITE_APP_ENV=iteration

VITE_GOOGLE_PLACES_API_KEY=

VITE_SUPABASE_URL=https://YOUR_ITERATION_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ITERATION_ANON_KEY

GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
FSQ_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173

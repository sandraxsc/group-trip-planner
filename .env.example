# --- Frontend (bundled into the browser; treat as public) ---
# Google Places (New) — search, details, hotel suggestions. Restrict key by HTTP referrer in GCP.
VITE_GOOGLE_PLACES_API_KEY=

# Optional: log itinerary food/meal scheduling in the browser console on production (e.g. debug missing meals on Vercel). Remove when done.
# VITE_DEBUG_ITINERARY=true

# Optional: traffic-aware transit (enable Routes API on the key you use).
# VITE_GOOGLE_ROUTES_ENABLED=true
# VITE_GOOGLE_ROUTES_API_KEY=

# --- Shared trip storage (Supabase) ---
# Optional. If set, invite links will work across devices.
#
# Plan B (separate DB per branch): copy .env.iteration.example → .env.iteration
# and .env.main.example → .env.main, then run `npm run env:iteration` or
# `npm run env:main` when you switch git branches. See those files for SQL setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only if the SPA and API are on different origins (no trailing slash).
# Dev: leave unset to use http://127.0.0.1:3001 (see src/config/apiProxy.ts).
# VITE_AI_PROXY_BASE_URL=https://api.example.com

# Optional: override API base for FSQ only (otherwise same as VITE_AI_PROXY_BASE_URL / dev default).
# VITE_FSQ_PROXY_URL=

# --- API proxy server only (server/fsq-proxy.js — never use VITE_ for these) ---
# Google Places (New) — server-side searchText to turn AI "pending" rows into real venues.
# Can match your VITE_GOOGLE_PLACES_API_KEY value; restrict key by IP for server-only use in production.
GOOGLE_PLACES_API_KEY=

# OpenAI (AI Enhance). Never expose this to the client.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Foursquare (if you use the FSQ proxy routes).
FSQ_API_KEY=

# Comma-separated browser origins allowed to call this API (CORS). No trailing slashes.
# Dev: if unset, permissive CORS for local work.
# Production (Render + Vercel SPA): REQUIRED. The browser still sends Origin: https://your-app.vercel.app
# on POST /api/... (Vercel rewrites to Render). If this list is missing or wrong, you get 403 from the proxy:
#   { "error": "CORS: set ALLOWED_ORIGINS in production" } or "CORS: origin not allowed"
# Production + ALL Vercel previews/branches (hostname ends with .vercel.app):
#   ALLOWED_ORIGINS=https://your-production.vercel.app,*.vercel.app
# Or list each preview URL explicitly if you prefer a tighter allowlist.
ALLOWED_ORIGINS=http://localhost:5173

# Proxy listen port (default 3001).
# PORT=3001
